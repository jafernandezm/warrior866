---
// src/pages/tags/[tag].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

type Doc = CollectionEntry<'docs'>;

// Base URL del sitio (respeta el `base` de astro.config.mjs).
// En dev: "/warrior866/", en prod igual. Si quitas el base, será "/".
const BASE = import.meta.env.BASE_URL.replace(/\/$/, ''); // sin trailing slash

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  console.log(`\n[tags] ───────────────────────────────────────────`);
  console.log(`[tags] Total docs loaded: ${docs.length}`);

  const tagMap = new Map<string, { displayTag: string; pages: Doc[] }>();

  for (const doc of docs) {
    const tags = ((doc.data as any).tags ?? []) as string[];
    if (tags.length > 0) {
      console.log(`[tags]   ${doc.id} → [${tags.join(', ')}]`);
    }
    for (const tag of tags) {
      const slug = tag.toLowerCase().trim().replace(/\s+/g, '-');
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { displayTag: tag, pages: [] });
      }
      tagMap.get(slug)!.pages.push(doc);
    }
  }

  console.log(`[tags] Unique tags found: ${tagMap.size}`);
  console.log(`[tags] ───────────────────────────────────────────\n`);

  return Array.from(tagMap.entries()).map(([slug, { displayTag, pages }]) => ({
    params: { tag: slug },
    props: { displayTag, pages },
  }));
}

interface Props {
  displayTag: string;
  pages: Doc[];
}

const { displayTag, pages } = Astro.props;

const sortedPages = [...pages].sort((a, b) =>
  String(a.data.title).localeCompare(String(b.data.title))
);
---

<StarlightPage
  frontmatter={{
    title: `Tag: #${displayTag}`,
    description: `Writeups etiquetados con #${displayTag}`,
    template: 'splash',
    tableOfContents: false,
  }}
>
  <p class="count">
    <strong>{pages.length}</strong> writeup{pages.length === 1 ? '' : 's'} con el tag <code>#{displayTag}</code>
  </p>

  <ul class="writeups-list">
    {sortedPages.map((doc) => {
      const cleanId = doc.id.replace(/\/index$/, '');
      // OJO: prefijar con BASE para respetar el base path
      const url = `${BASE}/${cleanId}/`;
      const badge = (doc.data.sidebar as any)?.badge;
      const docTags = ((doc.data as any).tags ?? []) as string[];

      return (
        <li class="writeup-card">
          <a href={url} class="writeup-link">
            <div class="writeup-header">
              <h2>{doc.data.title}</h2>
              {badge && (
                <span class={`badge badge--${badge.variant ?? 'note'}`}>
                  {badge.text}
                </span>
              )}
            </div>
            {doc.data.description && (
              <p class="writeup-desc">{doc.data.description}</p>
            )}
            {docTags.length > 0 && (
              <ul class="writeup-tags">
                {docTags.slice(0, 6).map((t) => (
                  <li class={t.toLowerCase() === displayTag.toLowerCase() ? 'active' : ''}>
                    #{t}
                  </li>
                ))}
              </ul>
            )}
          </a>
        </li>
      );
    })}
  </ul>

  <p class="back"><a href={`${BASE}/tags/`}>← Ver todos los tags</a></p>
</StarlightPage>

<style>
  .count {
    color: var(--sl-color-gray-2);
    margin-bottom: 2rem;
  }
  .count code {
    background: var(--sl-color-gray-6);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    color: var(--sl-color-accent-high);
  }
  .writeups-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
  .writeup-card { margin: 0; }
  .writeup-link {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
    height: 100%;
  }
  .writeup-link:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }
  .writeup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .writeup-header h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--sl-color-white);
  }
  .badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge--success { background: #1a4d2e; color: #4ade80; }
  .badge--caution { background: #4d3e1a; color: #facc15; }
  .badge--danger  { background: #4d1a1a; color: #f87171; }
  .badge--note    { background: var(--sl-color-gray-6); color: var(--sl-color-text-accent); }
  .writeup-desc {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin: 0.5rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .writeup-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .writeup-tags li {
    font-size: 0.75rem;
    background: var(--sl-color-gray-6);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-system-mono);
  }
  .writeup-tags li.active {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
  .back { margin-top: 2.5rem; text-align: center; }
  .back a { color: var(--sl-color-accent); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
</style>